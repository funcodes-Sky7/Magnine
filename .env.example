# ─────────────────────────────────────────────────────────────
# MANGANAI - Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to frontend/.env and fill in your values.
# The app runs fully in demo mode without any API keys.

# ── Google Maps API Key (optional) ───────────────────────────
# Get one at: https://console.cloud.google.com/
# Required Maps APIs: Maps JavaScript API, Visualization API
# Without this key, the app uses a built-in interactive demo map.
VITE_GOOGLE_MAPS_API_KEY=

# ── Backend API URL ───────────────────────────────────────────
# Default: FastAPI backend running locally on port 8000
VITE_API_BASE_URL=http://localhost:8000

# ── Google Earth Engine (GEE) Project ID ─────────────────────
# Required for live Sentinel-2 / DEM raster streaming
GEE_PROJECT_ID=vaulted-splice-465917-n1

# ── Demo Mode Flag ────────────────────────────────────────────
VITE_DEMO_MODE=true
